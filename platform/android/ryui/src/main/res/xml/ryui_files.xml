<?xml version="1.0" encoding="utf-8"?>
<!-- What the app shares through its FileProvider: the camera's photos, and
     the files ui.ShareFiles shares (the app's own folders; others are
     copied to its caches first). -->
<paths>
    <cache-path name="camera" path="ryui-camera/" />
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
    <external-files-path name="external-files" path="." />
    <external-cache-path name="external-cache" path="." />
</paths>
