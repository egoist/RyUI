<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <service android:name="dev.asuka.push.AsukaPushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- The channel Firebase shows notifications in while the app is in the background: asuka/sdk/notify's. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="asuka" />
    </application>
</manifest>
