<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The Google Pay API, which loadPaymentData needs enabled. -->
        <meta-data android:name="com.google.android.gms.wallet.api.enabled" android:value="true" />
        <!-- Google Pay's sheet calls it as the user changes the address, the shipping option or the card, and pays: the app's Go code answers. -->
        <service
            android:name="dev.asuka.pay.AsukaPayCallbacks"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_PAYMENTS_CALLBACK_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wallet.callback.PAYMENT_DATA_CALLBACKS" />
            </intent-filter>
        </service>
    </application>
</manifest>
