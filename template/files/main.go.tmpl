package main

import (
	"fmt"

	"github.com/egoist/asuka/app"
	"github.com/egoist/asuka/fonts"
	"github.com/egoist/asuka/signal"
	"github.com/egoist/asuka/ui"
)

func App() ui.Node {
	count := signal.New(0)
	return ui.SafeArea(ui.Style{Justify: ui.JustifyCenter, Align: ui.AlignCenter, Gap: 16},
		ui.Text(signal.Func(func() string {
			return fmt.Sprintf("{{.Name}}: %d", count.Get())
		}), ui.Style{Font: fonts.Title}),
		ui.Button(ui.ButtonProps{
			Title:   ui.Val("Add"),
			Variant: ui.ButtonFilled,
			OnPress: func() { count.Update(func(n int) int { return n + 1 }) },
		}),
	)
}

func main() { app.Run(App) }
